# Пример конфигурации для Anonymizer Proxy
# Скопируйте этот файл в .env и заполните своими значениями:
#   copy .env.example .env
# ВНИМАНИЕ: .env содержит секреты и НЕ должен попадать в git (.gitignore уже настроен)

# OpenRouter API ключ (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY

# Модель в OpenRouter (должна существовать в OpenRouter)
OPENROUTER_MODEL=qwen/qwen3.7-plus

# ---- Облачный провайдер (OpenAI-совместимые) ----
# Стартовый провайдер облака (действует сразу после установки и после сброса):
# openrouter (по умолчанию) | gptunnel | bothub | aitunnel | genapi | custom.
# Далее действующий провайдер выбирается в форме http://127.0.0.1:8081/env-editor
# или POST /api/backend и запоминается в data/runtime_state.json; команда
# в чате «работай через облако» возвращает к действующему провайдеру.
# CLOUD_PROVIDER=openrouter
#
# GPTunneL — https://gptunnel.ru (ключ: вкладка API в личном кабинете).
# Российский провайдер: работает БЕЗ VPN напрямую (VPN нужен только OpenRouter).
#GPTUNNEL_API_KEY=
#GPTUNNEL_MODEL=gpt-4o
#
# BotHub — https://bothub.chat (ключ: раздел API в личном кабинете).
# Без VPN; base URL нестандартный (api/v2/openai/v1) — уже прописан.
#BOTHUB_API_KEY=
#BOTHUB_MODEL=gpt-4o
#
# AITUNNEL — https://aitunnel.ru (ключ sk-aitunnel-… из раздела «Ключи»).
# Без VPN; модели в формате провайдер/модель, как в OpenRouter.
#AITUNNEL_API_KEY=
#AITUNNEL_MODEL=openai/gpt-4o
#
# GenAPI — https://gen-api.ru (ключ из личного кабинета). Без VPN.
#GENAPI_API_KEY=
#GENAPI_MODEL=gpt-5-4
#
# Свободно конфигурируемый OpenAI-совместимый endpoint (любой провайдер/шлюз):
#CUSTOM_BASE_URL=https://api.example.com/v1
#CUSTOM_API_KEY=
#CUSTOM_MODEL=model-name
#
# Базовые URL и таймауты переопределяются per-provider: <NAME>_BASE_URL,
# <NAME>_TIMEOUT. VPN-прокси по умолчанию ТОЛЬКО у OpenRouter
# (OPENROUTER_PROXY ниже); при необходимости задайте <NAME>_PROXY для
# конкретного провайдера (по умолчанию российские ходят напрямую).

# Локальная модель через llama-server (llama.cpp, OpenAI-совместимый API).
# Используется для сценариев, где данные не должны покидать машину
# (например, модель должна видеть конфиденциальные суммы в Excel).
# llama-server — общий сервис: к нему ходит прокси и другие приложения
# (RAG и т.п.). Прокси при старте сам проверяет, запущен ли сервер, и
# запускает его, если нет (LLM_SERVER_AUTOSTART=1).
# Переключение бэкенда на лету (без перезапуска прокси):
#   - команда в чате: «работай через локальную модель» / «работай через облако»
#   - POST /api/backend {"backend": "local"}  (GET /api/backend — текущий статус)
#   - имя модели в Cline: "local/qwen3.5-9b" — маршрутизируется локально
#
# ---- Управление llama-server (запуск/остановка) ----
# Путь к llama-server (пусто — автопоиск: общий llama-рантайм,
# tools/llama.cpp, PATH, Homebrew)
#LLM_SERVER_BIN=
# Путь к GGUF-файлу модели: shared:chat — общая чат-модель llama-рантайма
# машины (Windows: %LOCALAPPDATA%\llama-runtime, macOS:
# ~/Library/Application Support/llama-runtime; манифест —
# models/chat/current.json; менять — кнопкой в /env-editor, командой switch
# или python -m anonymizer_proxy.llama_runtime switch <файл>). Можно указать
# и явный путь к GGUF.
LLM_SERVER_MODEL=shared:chat
# Адрес привязки llama-server (родной дефолт llama.cpp — порт 8080)
LLM_SERVER_HOST=127.0.0.1
LLM_SERVER_PORT=8080
# Слоты конкурентности: 1 — запросы строго по очереди, каждый получает
# полный контекст (дефолт проекта; очередь бесплатна по памяти)
LLM_SERVER_PARALLEL=1
# Контекст на ОДИН запрос (файл через прокси / RAG-поиск). Общий буфер
# сервера вычисляется: PARALLEL × это значение.
LLM_SERVER_CTX_PER_SLOT=32768
# Ключ llama-server (пусто — без авторизации, допустимо на localhost)
#LLM_SERVER_API_KEY=
# Прокси при старте сам проверяет/запускает llama-server (1/0)
LLM_SERVER_AUTOSTART=1
# Доп. флаги llama-server: квантование KV-кэша (экономит ~50% памяти кэша
# практически без потери качества); добавьте --n-gpu-layers 99 для полной
# выгрузки весов на GPU, если памяти достаточно
LLM_SERVER_EXTRA_ARGS=--cache-type-k q8_0 --cache-type-v q8_0
# Сколько секунд ждать готовности /health при запуске (загрузка GGUF —
# десятки секунд)
#LLM_SERVER_START_TIMEOUT=300
#
# ---- Клиент прокси к llama-server ----
# Базовый URL: пусто — конструируется из LLM_SERVER_HOST/PORT.
#LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Имя модели llama-server (пусто — первая с сервера)
#LOCAL_LLM_MODEL=qwen3.5-9b-instruct
LOCAL_LLM_TIMEOUT=600
# Ключ авторизации на llama-server (обычно не требуется; приоритетнее
# LLM_SERVER_API_KEY)
#LOCAL_LLM_API_KEY=llama-server

# NER-движок (GLiNER) — локальная анонимизация
# Модель с HuggingFace (при первом запуске скачивается в кэш, дальше офлайн)
NER_MODEL=knowledgator/gliner-pii-large-v1.0
# Порог уверенности для сущностей (0.0–1.0)
NER_THRESHOLD=0.3
# Бэкенд инференса: auto|onnx — ONNX Runtime с автовыбором провайдера
# (CUDA → DirectML → CPU; нужен пакет onnxruntime / onnxruntime-gpu /
# onnxruntime-directml); torch — PyTorch (аварийный фоллбек)
NER_BACKEND=auto
# Устройство для PyTorch-фоллбэка: cpu (по умолчанию) или directml
NER_DEVICE=cpu
# Максимальный размер чанка (символы) на один вызов модели.
# Окно модели — 768 токенов (~2.4 симв./токен для русского): 1500 символов
# гарантируют отсутствие тихого усечения хвоста чанка; длиннее — чанки
NER_MAX_INPUT_CHARS=1500
# Перекрытие соседних чанков (символы): защищает сущности на границах чанков
NER_CHUNK_OVERLAP_CHARS=200
# Таймаут NER-вызова в секундах (страховочный)
NER_TIMEOUT_SECONDS=300

# ---- Детектирование чат-команд прокси (правила + GLiNER) ----
# Гибридная схема: дешёвый regex-префильтр → точные правила → GLiNER
# zero-shot (in-process, офлайн — модель уже загружена для NER).
# Перезапуск прокси распознаётся ТОЛЬКО правилами (деструктивная команда).
# Режим детектора команд: off (по умолчанию) — ТОЛЬКО regex-правила;
# auto — дополнительно GLiNER-слой для свободных формулировок
# (zero-shot-классификаторы нестабильны, поэтому по умолчанию выключены)
COMMAND_CLASSIFIER=off
# Порог скора GLiNER для признания команды (позитивы дают 0.05–0.23)
#COMMAND_CLASSIFIER_THRESHOLD=0.05
# Требуемый отрыв лучшей метки от второй (при близких скорах — воздержаться)
#COMMAND_CLASSIFIER_MARGIN=1.3
# Таймаут инференса детектора, сек
#COMMAND_CLASSIFIER_TIMEOUT=30


# Удаление картинок (логотипов) из колонтитулов анонимизированных DOCX.
# Вместе с картинками из пакета вымываются их media-файлы (иначе логотипы
# остаются в word/media/ и читаются из ZIP напрямую).
REMOVE_HEADER_IMAGES=1

# Прокси для OpenRouter (VPN)
# HTTP-прокси Happ на порту 10809
OPENROUTER_PROXY=http://127.0.0.1:10809

# Настройки прокси
# ВАЖНО: оставляйте 127.0.0.1, если не используете файрвол/туннель.
# Для 0.0.0.0 ОБЯЗАТЕЛЬНО задайте PROXY_API_TOKEN.
PROXY_HOST=127.0.0.1
PROXY_PORT=8081

# Токен доступа к административным /api/* эндпоинтам (логи, де-анонимизация, экспорт).
# Настоятельно рекомендуется задать. Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Режим работы: full или manual
# full - полная обработка: анонимизация → облако → де-анонимизация
# manual - явное управление: запросы Cline идут без анонимизации (основной)
ANONYMIZER_MODE=manual

# Keep-alive во время подготовки (NER): прокси периодически отдаёт клиенту
# нейтральные SSE-комментарии, пока идёт анонимизация, чтобы клиент не считал
# запрос зависшим. Отключить: KEEPALIVE_ENABLED=false.
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=3

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Исключаем localhost из VPN
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1