#!/bin/zsh
# ============================================================
#  Anonymizer Proxy — установка двойным кликом из Finder (macOS)
#
#  Finder открывает .command-файлы в Терминале; скрипт запускается
#  из своего каталога независимо от CWD. Вся работа выполняется в
#  install.sh (карантин Gatekeeper, системные требования, окружение
#  uv, общий llama-рантайм, .env, NER-модели, self-test, ярлыки).
#
#  Первый запуск файла, скачанного из интернета, macOS может
#  заблокировать (карантин): тогда ПКМ по файлу → «Открыть», либо
#  выполнить в Терминале: bash install.command
# ============================================================
cd "$(dirname "$0")" || exit 1

if [ ! -f install.sh ]; then
    echo "[ОШИБКА] Рядом с этим файлом нет install.sh — распакуйте архив целиком."
    echo "(Нажмите Enter, чтобы закрыть окно)"
    read -r _
    exit 1
fi

echo "== Anonymizer Proxy: установка (macOS) =="
bash install.sh
rc=$?

echo ""
if [ "$rc" -eq 0 ]; then
    echo "Установка завершена — запуск: Anonymizer Proxy.app или start_proxy.command."
else
    echo "Установка завершилась с ошибкой (код $rc) — см. сообщения выше."
fi
echo "(Нажмите Enter, чтобы закрыть это окно)"
read -r _
exit $rc
