{
  "name": "anonymizer-proxy",
  "displayName": "Anonymizer Proxy — Пульт управления",
  "description": "Пульт управления Anonymizer Proxy: просмотр активных сессий, отправка анонимизированных промптов, де-анонимизация файлов.",
  "version": "0.2.0",
  "publisher": "local",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:anonymizerProxy.sessionsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anonymizerProxy",
          "title": "Anonymizer Proxy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "anonymizerProxy": [
        {
          "id": "anonymizerProxy.sessionsView",
          "name": "Сессии",
          "type": "tree"
        }
      ]
    },
    "commands": [
      { "command": "anonymizerProxy.refreshSessions", "title": "Anonymizer Proxy: Обновить сессии", "icon": "$(refresh)" },
      { "command": "anonymizerProxy.openMd", "title": "Открыть .md", "icon": "$(open-preview)" },
      { "command": "anonymizerProxy.send", "title": "Отправить в облако", "icon": "$(send)" },
      { "command": "anonymizerProxy.deanonymizeFile", "title": "Де-анонимизировать файл", "icon": "$(file-binary)" }
    ],
    "menus": {
      "view/title": [
        { "command": "anonymizerProxy.refreshSessions", "when": "view == anonymizerProxy.sessionsView", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "anonymizerProxy.openMd", "when": "view == anonymizerProxy.sessionsView && viewItem == session", "group": "inline@1" },
        { "command": "anonymizerProxy.send", "when": "view == anonymizerProxy.sessionsView && viewItem == session", "group": "inline@2" },
        { "command": "anonymizerProxy.deanonymizeFile", "when": "view == anonymizerProxy.sessionsView && viewItem == session", "group": "inline@3" }
      ]
    },
    "configuration": {
      "title": "Anonymizer Proxy",
      "properties": {
        "anonymizerProxy.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8081",
          "description": "Базовый URL прокси-сервера Anonymizer Proxy."
        },
        "anonymizerProxy.apiToken": {
          "type": "string",
          "default": "",
          "description": "PROXY_API_TOKEN для доступа к /api/* эндпоинтам (если задан в .env прокси)."
        },
        "anonymizerProxy.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "Интервал опроса списка сессий (мс)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
