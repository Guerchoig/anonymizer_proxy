{
  "name": "anonymizer-proxy",
  "displayName": "Anonymizer Proxy — Ручное ревью",
  "description": "Панель ручного ревью анонимизированных промптов Anonymizer Proxy: просмотр, правка и одобрение/отклонение перед отправкой в облако.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:anonymizerProxy.reviewView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anonymizerProxy",
          "title": "Anonymizer Proxy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "anonymizerProxy": [
        {
          "id": "anonymizerProxy.reviewView",
          "name": "Ручное ревью",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "anonymizerProxy.refreshReviews",
        "title": "Anonymizer Proxy: Обновить список ревью",
        "icon": "$(refresh)"
      },
      {
        "command": "anonymizerProxy.openFile",
        "title": "Открыть .md",
        "icon": "$(open-preview)"
      },
      {
        "command": "anonymizerProxy.approveWithEdits",
        "title": "Одобрить (с правками из файла)",
        "icon": "$(check)"
      },
      {
        "command": "anonymizerProxy.approveNoEdits",
        "title": "Одобрить (без правок)",
        "icon": "$(check-all)"
      },
      {
        "command": "anonymizerProxy.reject",
        "title": "Отклонить",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anonymizerProxy.refreshReviews",
          "when": "view == anonymizerProxy.reviewView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "anonymizerProxy.openFile",
          "when": "view == anonymizerProxy.reviewView && viewItem == pendingReview",
          "group": "inline@1"
        },
        {
          "command": "anonymizerProxy.approveWithEdits",
          "when": "view == anonymizerProxy.reviewView && viewItem == pendingReview",
          "group": "inline@2"
        },
        {
          "command": "anonymizerProxy.approveNoEdits",
          "when": "view == anonymizerProxy.reviewView && viewItem == pendingReview",
          "group": "inline@3"
        },
        {
          "command": "anonymizerProxy.reject",
          "when": "view == anonymizerProxy.reviewView && viewItem == pendingReview",
          "group": "inline@4"
        }
      ]
    },
    "configuration": {
      "title": "Anonymizer Proxy",
      "properties": {
        "anonymizerProxy.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8081",
          "description": "Базовый URL прокси-сервера Anonymizer Proxy."
        },
        "anonymizerProxy.apiToken": {
          "type": "string",
          "default": "",
          "description": "PROXY_API_TOKEN для доступа к /api/* эндпоинтам (если задан в .env прокси)."
        },
        "anonymizerProxy.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "Интервал опроса очереди ревью (мс)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
