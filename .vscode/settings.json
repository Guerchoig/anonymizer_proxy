{
    // Интерпретатор проекта: подхватывается автоматически при открытии папки
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    // Тесты проекта — исполняемые скрипты (не pytest/unittest), автодетект отключён
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": false,
    "files.exclude": {
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/data": true,
        "**/__pycache__": true,
        "**/.venv": true
    }
}
