{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запуск прокси (anonymizer_proxy.main)",
            "type": "debugpy",
            "request": "launch",
            "module": "anonymizer_proxy.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Текущий файл (тест/скрипт)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
