#!/bin/zsh
# ============================================================
#  Anonymizer Proxy — запуск двойным кликом из Finder (macOS)
#  Finder открывает .command-файлы в Терминале; скрипт
#  запускается из своего каталога независимо от CWD.
#
#  Поведение:
#  - если прокси УЖЕ запущен — просто открывается страница
#    настроек (/env-editor) в браузере по умолчанию, второй
#    экземпляр не поднимается (окно можно закрыть по Enter);
#  - иначе сервер стартует в этом окне, и когда он будет готов,
#    страница настроек откроется сама. Закрытие страницы
#    прокси не останавливает.
# ============================================================
cd "$(dirname "$0")" || exit 1

PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "[ОШИБКА] Не найден .venv/bin/python"
    echo "Сначала выполните установку: bash install.sh"
    echo "(Нажмите Enter, чтобы закрыть окно)"
    read -r _
    exit 1
fi

# Прокси уже запущен — открываем страницу настроек и выходим.
if "$PY" -m anonymizer_proxy.launcher check >/dev/null 2>&1; then
    "$PY" -m anonymizer_proxy.launcher open
    echo "Прокси уже запущен — страница настроек открыта в браузере."
    echo "(Нажмите Enter, чтобы закрыть это окно)"
    read -r _
    exit 0
fi

echo "Запуск Anonymizer Proxy…"
echo "Страница настроек откроется в браузере, когда сервер будет готов."
echo "Остановка: Ctrl+C в этом окне (сервер завершится вместе с ним)."
exec "$PY" -m anonymizer_proxy.main --open-settings "$@"
